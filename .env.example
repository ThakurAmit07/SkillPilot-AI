# ==========================================================
# SkillPilot AI — Environment Configuration Template
# Copy this file to .env and configure local values
# ==========================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (PostgreSQL with SQLite local dev fallback)
# For local dev without Postgres: leave as sqlite:///instance/skillpilot.db
# For PostgreSQL: postgresql://username:password@localhost:5432/skillpilot_db
DATABASE_URL=sqlite:///instance/skillpilot.db

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads/resumes

# AI & NLP Configuration (Google Gemini API)
# Server-side integration only: generate key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=5000
